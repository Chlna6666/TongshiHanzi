<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="朗读"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="voice_mode"
            android:defaultValue="auto"
            android:entries="@array/voice_mode_entries"
            android:entryValues="@array/voice_mode_values"
            android:summary="%s"
            android:title="声音偏好"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="voice_name"
            android:defaultValue=""
            android:title="具体中文语音"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            android:key="speech_rate"
            android:defaultValue="90"
            android:max="150"
            android:min="50"
            android:title="语速"
            app:iconSpaceReserved="false"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="speech_pitch"
            android:defaultValue="100"
            android:max="150"
            android:min="50"
            android:title="音调"
            app:iconSpaceReserved="false"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:key="auto_speak"
            android:defaultValue="false"
            android:title="进入详情自动朗读"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="test_voice"
            android:summary="你好，我是童识汉字。"
            android:title="试听语音"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="外观"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="theme_mode"
            android:defaultValue="system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:summary="%s"
            android:title="深色模式"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="dynamic_color"
            android:defaultValue="true"
            android:summary="Android 12 及以上根据壁纸生成 Material 3 配色"
            android:title="使用系统动态配色"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="motion_mode"
            android:defaultValue="full"
            android:entries="@array/motion_entries"
            android:entryValues="@array/motion_values"
            android:summary="页面与控件使用可打断弹簧反馈；不包含悬浮或循环动画"
            android:title="界面动效"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="font_scale"
            android:defaultValue="normal"
            android:entries="@array/font_entries"
            android:entryValues="@array/font_values"
            android:summary="%s"
            android:title="内容字号"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="show_traditional"
            android:defaultValue="true"
            android:title="显示繁体字"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="查询"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="loose_pinyin"
            android:defaultValue="false"
            android:summary="允许少量声母近似匹配；精确结果仍然优先"
            android:title="宽松拼音搜索"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="save_history"
            android:defaultValue="true"
            android:title="保存查询历史"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="clear_history"
            android:title="清除查询历史"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="关于"
        app:iconSpaceReserved="false">

        <Preference
            android:key="about"
            android:summary="版本、隐私、源码与数据许可证"
            android:title="关于童识汉字"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
